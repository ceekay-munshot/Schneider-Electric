# Local development only. Copy to `.env` and fill in real values.
# NEVER commit a real .env (it is gitignored).
#
# In CI these come from the GitHub Actions repository secrets of the same name;
# you do NOT put real values here for CI.
#
# Run locally with:  node --env-file=.env src/capture-rexel.js   (Node 20.6+)
#            or:      REXELUSA_EMAIL=... REXELUSA_PASSWORD=... npm run capture:rexel

REXELUSA_EMAIL=you@example.com
REXELUSA_PASSWORD=your-password

# Optional toggles ----------------------------------------------------------
# DEBUG=1                 # print counts & field presence only (never secrets)
# REXEL_SOFT_FAIL=1       # exit 0 even on auth_failed_or_price_hidden
# OUTPUT_DIR=output       # where capture files are written
# REXEL_MIN_DELAY_MS=1200 # conservative pacing knobs
# REXEL_MAX_DELAY_MS=2600
# REXEL_MAX_SCROLL=60
